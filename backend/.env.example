# --- Required ---
GROQ_API_KEY=your_groq_key_from_console.groq.com
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=resume_builder

# --- Optional ---
# LLM_MODEL=openai/gpt-oss-20b          # list usable models: GET https://api.groq.com/openai/v1/models
# CORS_ORIGINS=["https://your-frontend.example.com"]
# TRUST_PROXY=true                      # set when deployed behind Render/Nginx so per-IP limits see the real client

# Free-tier protection (defaults shown). Size the daily caps from https://console.groq.com/settings/limits
# IP_ANALYZE_PER_HOUR=5
# IP_ANALYZE_PER_DAY=15
# IP_TAILOR_PER_HOUR=4
# IP_TAILOR_PER_DAY=10
# DAILY_ANALYZE_CAP=60
# DAILY_TAILOR_CAP=30
